# URL de conexión a tu base de datos PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
POSTGRES_URL="postgres://usuario:password@host.postgres.database.azure.com:5432/polls_db?sslmode=require"

# O si tu proveedor usa DATABASE_URL:
DATABASE_URL="postgres://usuario:password@host:5432/polls_db?sslmode=require"

# Activar SSL en entornos serverless (true para producción en la nube)
DATABASE_SSL="true"
